<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PetAgeCounter.MainPage">

    <Grid RowDefinitions="*,Auto,Auto,Auto" Padding="0,0,0,8">
        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding Persons}"
                        SelectionMode="None"
                        Margin="30,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Редактировать"
                                    IconImageSource="pen.png"
                                    BackgroundColor="LightGreen"
                                    Invoked="OnEditSwipeItemInvoked" />
                                <SwipeItem Text="Удалить"
                                    IconImageSource="delete.png"
                                    BackgroundColor="LightPink"
                                    Invoked="OnDeleteSwipeItemInvoked" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <HorizontalStackLayout Padding="0,8">
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" FontSize="Medium" FontAttributes="Bold"/>
                                <Label Text="{Binding BirthDate, StringFormat='{0:dd MMMM yyyy}'}" FontSize="Small" TextColor="Gray" />
                                <Label Text="{Binding DeathDate, StringFormat='Ушёл: {0:dd MMMM yyyy}'}"
                                       FontSize="Small"
                                       TextColor="Gray"
                                       IsVisible="{Binding IsDeceased}" />
                            </VerticalStackLayout>
                            <Label FontSize="Large" Text="{Binding FormattedOffset}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1"
            x:Name="AddButton"
            Text="Добавить"
            Clicked="OnAddItemClicked"
            Margin="30,8"
            HorizontalOptions="Fill" />

        <BoxView Grid.Row="2" HeightRequest="1" Color="#E0E0E0" />

        <Grid Grid.Row="3" ColumnDefinitions="*,*,*" Padding="12,8" ColumnSpacing="8">
            <ImageButton x:Name="AliveFilterButton"
                         Grid.Column="0"
                         Source="neon_mouse.png"
                         BackgroundColor="Transparent"
                         HeightRequest="48"
                         Aspect="AspectFit"
                         Clicked="OnAliveFilterClicked" />
            <ImageButton x:Name="DeceasedFilterButton"
                         Grid.Column="1"
                         Source="rainbow.svg"
                         BackgroundColor="Transparent"
                         HeightRequest="48"
                         Aspect="AspectFit"
                         Clicked="OnDeceasedFilterClicked" />
            <ImageButton x:Name="SettingsButton"
                         Grid.Column="2"
                         Source="settings.svg"
                         BackgroundColor="Transparent"
                         HeightRequest="48"
                         Aspect="AspectFit"
                         Clicked="OnSettingsClicked" />
        </Grid>
    </Grid>

</ContentPage>
