<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgeCounter.MainPage"
             >

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <ListView ItemsSource="{Binding Persons}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Edit"
                                            IconImageSource="pen.png"
                                            BackgroundColor="LightGreen"
                                            Invoked="OnEditSwipeItemInvoked" />
                                        <SwipeItem Text="Delete"
                                            IconImageSource="delete.png"
                                            BackgroundColor="LightPink"
                                            Invoked="OnDeleteSwipeItemInvoked" />
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <HorizontalStackLayout>
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Name}" FontSize="Medium" FontAttributes="Bold"/>
                                        <Label Text="{Binding BirthDate, StringFormat='{0:dd MMMM yyyy}'}" FontSize="Small" TextColor="Gray" />
                                    </VerticalStackLayout>
                                    <Label FontSize="Large" Text="{Binding FormattedOffset}" />
                                </HorizontalStackLayout>
                            </SwipeView>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button
                x:Name="CounterBtn"
                Text="Добавить" 
                SemanticProperties.Hint="Counts the number of times you click"
                Clicked="OnAddItemClicked"
                HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
