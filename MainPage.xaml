<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PetAgeCounter.MainPage">

    <Grid RowDefinitions="*,Auto,Auto" Padding="0,0,0,8">
        <Grid Grid.Row="0">
            <CollectionView ItemsSource="{Binding Persons}"
                            SelectionMode="None"
                            Margin="30,0,30,72">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItemView BackgroundColor="Transparent"
                                                   Invoked="OnEditSwipeItemInvoked">
                                        <Border WidthRequest="56"
                                                HeightRequest="56"
                                                BackgroundColor="#1E88E5"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 14"
                                                VerticalOptions="Center"
                                                Margin="0,0,6,0">
                                            <Image Source="edit.svg"
                                                   WidthRequest="22"
                                                   HeightRequest="22"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                    </SwipeItemView>
                                    <SwipeItemView BackgroundColor="Transparent"
                                                   Invoked="OnDeleteSwipeItemInvoked">
                                        <Border WidthRequest="56"
                                                HeightRequest="56"
                                                BackgroundColor="#E53935"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 14"
                                                VerticalOptions="Center"
                                                Margin="0,0,8,0">
                                            <Image Source="delete.svg"
                                                   WidthRequest="22"
                                                   HeightRequest="22"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                    </SwipeItemView>
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <HorizontalStackLayout Padding="0,8">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Name}" FontSize="Medium" FontAttributes="Bold"/>
                                    <Label Text="{Binding BirthDate, StringFormat='{0:dd MMMM yyyy}'}" FontSize="Small" TextColor="Gray" />
                                    <Label Text="{Binding DeathDate, StringFormat='Ушёл: {0:dd MMMM yyyy}'}"
                                           FontSize="Small"
                                           TextColor="Gray"
                                           IsVisible="{Binding IsDeceased}" />
                                </VerticalStackLayout>
                                <Label FontSize="Large" Text="{Binding FormattedOffset}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border x:Name="AddButton"
                    WidthRequest="56"
                    HeightRequest="56"
                    BackgroundColor="{StaticResource Primary}"
                    StrokeThickness="0"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="16"
                    StrokeShape="RoundRectangle 28"
                    SemanticProperties.Description="Добавить питомца">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.35" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddItemClicked" />
                </Border.GestureRecognizers>
                <Image Source="plus.svg"
                       WidthRequest="24"
                       HeightRequest="24"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </Grid>

        <BoxView Grid.Row="1" HeightRequest="1" Color="#E0E0E0" />

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" Padding="12,8" ColumnSpacing="8">
            <ImageButton x:Name="AliveFilterButton"
                         Grid.Column="0"
                         Source="neon_mouse.png"
                         BackgroundColor="Transparent"
                         HeightRequest="48"
                         Aspect="AspectFit"
                         Clicked="OnAliveFilterClicked" />
            <ImageButton x:Name="DeceasedFilterButton"
                         Grid.Column="1"
                         Source="rainbow.svg"
                         BackgroundColor="Transparent"
                         HeightRequest="48"
                         Aspect="AspectFit"
                         Clicked="OnDeceasedFilterClicked" />
            <ImageButton x:Name="SettingsButton"
                         Grid.Column="2"
                         Source="settings.svg"
                         BackgroundColor="Transparent"
                         HeightRequest="48"
                         Aspect="AspectFit"
                         Clicked="OnSettingsClicked" />
        </Grid>
    </Grid>

</ContentPage>
